# Copy to .env (gitignored) and fill in.

# Hugging Face
HF_TOKEN=
HF_HOME=./.hf_cache

# Base model — any HuggingFace model ID or local path.
# Examples:
#   Qwen/Qwen3.6-27B                          (default; SSM hybrid VLM)
#   meta-llama/Llama-3.1-8B-Instruct
#   mistralai/Mistral-7B-Instruct-v0.3
BASE_MODEL=Qwen/Qwen3.6-27B

# Experiment tracking (optional)
WANDB_API_KEY=
WANDB_PROJECT=pslab-finetuning

# Paths
DATA_DIR=./data
MODELS_DIR=./models

# Multi-GPU (see README "Multi-GPU training"). Training uses `make cpt NPROC=4`; nothing
# below is needed on a healthy rig — uncomment only to troubleshoot.
#   Restrict which cards are visible (also how the eval fan-out pins one worker per GPU):
# CUDA_VISIBLE_DEVICES=0,1,2,3
#   NCCL hangs at init on NVLink-less PCIe rigs are usually peer-to-peer; check the topology
#   with `nvidia-smi topo -m`, then try:
# NCCL_P2P_DISABLE=1
#   Verbose NCCL logging when a run stalls before the first step:
# NCCL_DEBUG=INFO

# llama.cpp (for GGUF export, if not using Unsloth's built-in exporter)
LLAMA_CPP_DIR=./llama.cpp
